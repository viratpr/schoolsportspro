# Database (used by API and Prisma)
# Local Postgres example:
# DATABASE_URL=postgresql://test_user:test_password@localhost:5432/schoolsportspro?sslmode=disable
#
# Supabase — prefer Transaction pooler (port 6543) for serverless/Vercel and many concurrent clients.
# User is postgres.<project-ref> (not plain "postgres"). Host looks like aws-0-<region>.pooler.supabase.com
# Password: URL-encode special characters (@ → %40, # → %23, etc.).
# Prisma + PgBouncer: add pgbouncer=true (and often connection_limit=1 for migrate).
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Direct connection (port 5432, host db.<project-ref>.supabase.co) is better for long-lived servers, not ideal for serverless.
# If db.*:5432 is unreachable (P1001), use Session pooler URI (port 5432, aws-*-pooler host) from Supabase Connect.
#
# First Prisma migrate deploy on a non-empty DB (no _prisma_migrations): P3005. If schema already matches the repo,
# run: pnpm db:baseline then pnpm db:migrate:deploy. If schema is behind, apply missing SQL first or use a fresh DB.
# If seed then errors (e.g. column internationalTemplateJson missing), you baselined too early: pnpm db:repair-drift then pnpm db:seed.
#
# Login: tries Prisma bcrypt first, then (if Supabase env is set) Supabase Auth + /auth/supabase-bridge.
# A row in public."User" (role/tenant) is still required — same email as Supabase. passwordHash can be null
# for Supabase-only users. Run: pnpm db:migrate && pnpm db:seed
# Demo school admin: admin@demoschool.local / School@1234 — platform: admin@platform.local / Admin@1234
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/schoolsportspro?sslmode=disable

# Supabase Auth (optional fallback on the same login form). Use project URL + anon (publishable) key.
# Set the same values on Vercel for the web app and API (API verifies tokens for /auth/supabase-bridge).
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Prefer NEXT_PUBLIC_SUPABASE_ANON_KEY (JWT eyJ… under Project API keys → anon public). Publishable sb_… keys
# can fail signInWithPassword; only use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY if anon is not available.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optional server-only aliases: SUPABASE_URL, SUPABASE_ANON_KEY (otherwise NEXT_PUBLIC_* are read on the API).
# Set to false to skip Supabase on login (only /auth/login). Use when debugging: seeded DB works locally but Vercel DATABASE_URL differs.
# NEXT_PUBLIC_AUTH_SUPABASE_FALLBACK=false

# JWT secret (must match between Next.js and API for session token)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# NextAuth (Next.js) – required for login; copy to apps/web/.env or set when running web app
# Use port 3000 if using "pnpm dev:web", or 3002 if using "pnpm dev:web:alt"
# If you change NEXTAUTH_SECRET, clear site cookies for localhost or use a private window to avoid JWT decryption errors.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# API URL (browser + Next.js server: NextAuth, proxies, client fetch).
# Local two-process dev (pnpm dev): Fastify on :3001 — use http://127.0.0.1:3001 (default in code if unset).
# Single Vercel project (Next + Fastify via /api/rest): set to https://<your-domain>/api/rest, or leave unset
# so production uses same-origin /api/rest (browser) and https://${VERCEL_URL}/api/rest (server).
# If you set only https://<your-domain> (no path), the app auto-appends /api/rest (except http://127.0.0.1:3001).
# Optional: on Vercel only, NextAuth/server code calls this API base instead of https://${VERCEL_URL}/api/rest
# (split-backend setups). Example: https://api.example.com or https://api.example.com/api/rest
# SERVER_API_BASE_URL=
#
# Never set NEXT_PUBLIC_API_URL to localhost/127.0.0.1 on Vercel — it is baked into the browser too
# and breaks signup / client API calls unless ignored (see getApiBaseUrl); prefer unset or https://…/api/rest.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Optional: Redis (MVP uses in-memory cache; set REDIS_URL to use Redis)
# REDIS_URL=redis://localhost:6379

# API server port (default 3001)
# PORT=3001

# Public app URL (sitemap, etc.)
APP_URL=http://localhost:3000

# Stripe (billing)
# Checkout, portal, and webhook verification run on the Fastify API (same process as API routes).
# Webhook URL options: https://<app>/api/billing/webhook (Next proxy, raw body) or
# https://<app>/api/rest/billing/stripe/webhook (direct to Fastify under single-project deploy).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_TOURNAMENT_PASS=price_...
STRIPE_PRICE_ID_ANNUAL_PRO=price_...

# --- Docker Compose deploy (server: copy these into `.env` next to docker-compose.yml) ---
# Use the **same** JWT_SECRET you trust for production. Web uses NEXTAUTH_SECRET; if you omit it, compose sets
# NEXTAUTH_SECRET = JWT_SECRET so you only maintain one long secret.
# JWT_SECRET=...
# NEXTAUTH_SECRET=   # optional; defaults to JWT_SECRET
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_TOURNAMENT_PASS=price_...
# STRIPE_PRICE_ID_ANNUAL_PRO=price_...
# Public URLs your users hit (replace with your domain)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXTAUTH_URL=https://app.example.com
# APP_URL=https://app.example.com

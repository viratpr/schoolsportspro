# Database (used by API and Prisma)
# host=localhost, user=test_user, password=test_password, dbname=Bharatathlete, port=5432, sslmode=disable
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/Bharatathlete?sslmode=disable

# JWT secret (must match between Next.js and API for session token)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# NextAuth (Next.js) – required for login; copy to apps/web/.env or set when running web app
# Use port 3000 if using "pnpm dev:web", or 3002 if using "pnpm dev:web:alt"
# If you change NEXTAUTH_SECRET, clear site cookies for localhost or use a private window to avoid JWT decryption errors.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# API URL (from browser and Next.js server). Use 127.0.0.1 if login is slow (avoids IPv6 localhost on Windows)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Optional: Redis (MVP uses in-memory cache; set REDIS_URL to use Redis)
# REDIS_URL=redis://localhost:6379

# API server port (default 3001)
# PORT=3001

# Public app URL (sitemap, etc.)
APP_URL=http://localhost:3000

# Razorpay (billing) – get keys from https://dashboard.razorpay.com
# Next.js loads this file from the repo root (see apps/web/next.config.js) so billing API routes work with the same .env as the API.
# Production: configure the same variables in your host (e.g. Vercel/project Settings → Environment Variables,
# or Docker/Kubernetes runtime env). They must exist at runtime for the **Next.js web** process (not API-only).
# SOPS/Kubernetes files often name keys razorpay_key_id / razorpay_key_secret; if those names are injected as env vars, the app reads them too.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# If your host only allows one “secret” name, you can use this alias instead of RAZORPAY_KEY_SECRET:
# RAZORPAY_SECRET=...
# Optional: publishable key for Checkout ( otherwise RAZORPAY_KEY_ID is sent from create-order )
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Optional: your Razorpay public profile / payment page (e.g. https://razorpay.me/@abenkainfotechprivatelimited).
# In-app checkout still uses the Orders API with GST-inclusive totals; this link is shown on Billing for transparency.
# NEXT_PUBLIC_RAZORPAY_PAYMENT_PAGE_URL=https://razorpay.me/@abenkainfotechprivatelimited

# --- Docker Compose deploy (server: copy these into `.env` next to docker-compose.yml) ---
# Use the **same** JWT_SECRET you trust for production. Web uses NEXTAUTH_SECRET; if you omit it, compose sets
# NEXTAUTH_SECRET = JWT_SECRET so you only maintain one long secret.
# JWT_SECRET=...
# NEXTAUTH_SECRET=   # optional; defaults to JWT_SECRET
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
# Public URLs your users hit (replace with your domain)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXTAUTH_URL=https://app.example.com
# APP_URL=https://app.example.com

# Database (used by API and Prisma)
# Local Postgres example:
# DATABASE_URL=postgresql://test_user:test_password@localhost:5432/schoolsportspro?sslmode=disable
# Supabase pooled connection example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/schoolsportspro?sslmode=disable

# JWT secret (must match between Next.js and API for session token)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# NextAuth (Next.js) – required for login; copy to apps/web/.env or set when running web app
# Use port 3000 if using "pnpm dev:web", or 3002 if using "pnpm dev:web:alt"
# If you change NEXTAUTH_SECRET, clear site cookies for localhost or use a private window to avoid JWT decryption errors.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# API URL (from browser and Next.js server). Use 127.0.0.1 if login is slow (avoids IPv6 localhost on Windows)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Optional: Redis (MVP uses in-memory cache; set REDIS_URL to use Redis)
# REDIS_URL=redis://localhost:6379

# API server port (default 3001)
# PORT=3001

# Public app URL (sitemap, etc.)
APP_URL=http://localhost:3000

# Stripe (billing)
# Checkout, portal, and webhook verification run on the Fastify API.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_TOURNAMENT_PASS=price_...
STRIPE_PRICE_ID_ANNUAL_PRO=price_...

# --- Docker Compose deploy (server: copy these into `.env` next to docker-compose.yml) ---
# Use the **same** JWT_SECRET you trust for production. Web uses NEXTAUTH_SECRET; if you omit it, compose sets
# NEXTAUTH_SECRET = JWT_SECRET so you only maintain one long secret.
# JWT_SECRET=...
# NEXTAUTH_SECRET=   # optional; defaults to JWT_SECRET
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_TOURNAMENT_PASS=price_...
# STRIPE_PRICE_ID_ANNUAL_PRO=price_...
# Public URLs your users hit (replace with your domain)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXTAUTH_URL=https://app.example.com
# APP_URL=https://app.example.com
